<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The console emulator is the product's own executable, so it carries the product name (NAMING.md "Project and executable names"). -->
    <AssemblyName>NDMicroCpu</AssemblyName>
    <RootNamespace>NDMicroCpu.Machine</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NDMicroCpu.Core\NDMicroCpu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BPUN test programs the machine can boot over the bus (INSTRUCTION-B is the default). -->
    <None Include="BPUN\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
