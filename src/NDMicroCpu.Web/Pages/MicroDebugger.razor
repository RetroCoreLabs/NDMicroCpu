        border: 1px solid;
        white-space: pre-wrap;
    }


    .decorationGlyphMarginClassRed {
        background: red;
    }

    .decorationGlyphMarginClass {
        background: black;
    }

    .decorationContentClass {
        background: lightblue;
    }
</style>


<PageTitle>MicroCode Debugger</PageTitle>

<div>
