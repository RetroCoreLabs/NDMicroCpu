@page "/Debugger"
@using NDMicroCpu.Core;
@using static NDMicroCpu.Core.Enums;
@inject IAppService appService
@implements IDisposable



@if (!appService.IsInitialized)
{
    <MudContainer Class="mt-16">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Loading MicroCode Debugger...</MudText>
        <div class="d-flex justify-center mt-8">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
        <MudText Align="Align.Center" Class="mt-4">Downloading microcode files and initializing CPU...</MudText>
    </MudContainer>
}
else
{


