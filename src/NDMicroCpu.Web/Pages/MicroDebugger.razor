    <MudContainer Fixed="false" MaxWidth="MaxWidth.ExtraExtraLarge">
        <MudGrid Class="mt-3">
            <MudItem md="12">
                <MudCard Elevation="25" Class="rounded-lg pb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h5" Align="Align.Center">ND-110 Microcode</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <NDMicroCpu.Web.Components.MicroCodeEditor sourceCode="@appService.microCodeSource" @ref="_mcEdit"></NDMicroCpu.Web.Components.MicroCodeEditor>
                    </MudCardContent>

                    <MudCardActions Class="m-3">
                        <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
