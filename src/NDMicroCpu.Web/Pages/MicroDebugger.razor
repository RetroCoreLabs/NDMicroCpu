    <MudGrid Class="mt-1">
    <MudItem md="5">
    <MudText Typo="Typo.h5" Align="Align.Center">ALU RAM</MudText>
    <NDMicroCpu.Web.Components.Registers></NDMicroCpu.Web.Components.Registers>
    </MudItem>
    <MudItem md="5">
    <MudText Typo="Typo.h5" Align="Align.Center">ALU REGS</MudText>
    <NDMicroCpu.Web.Components.AluRegisters></NDMicroCpu.Web.Components.AluRegisters>
    </MudItem>
    </MudGrid>
