    <MudText Typo="Typo.caption" Style="color:#999;">Last compiled: @buildTimestamp</MudText>
</div>

@code {
    // Build timestamp stamped into the assembly at compile time by the
    // StampBuildTimestamp MSBuild target (see NDMicroCpu.Web.csproj). Read here via
    // reflection and shown in the footer above. No LINQ / no foreach per project rules.
    private string buildTimestamp = "unknown";

    protected override void OnInitialized()
    {
        var attrs = GetType().Assembly.GetCustomAttributes(
            typeof(System.Reflection.AssemblyMetadataAttribute), false);
        for (int i = 0; i < attrs.Length; i++)
        {
            var meta = (System.Reflection.AssemblyMetadataAttribute)attrs[i];
            if (meta.Key == "BuildTimestampUtc")
            {
                buildTimestamp = meta.Value ?? "unknown";
                break;
            }
        }
    }
}
