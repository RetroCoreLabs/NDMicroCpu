@code {

    [Parameter]
    public RegisterFile? RegisterFile { get; set; }
    [Parameter]
    public ushort RegisterLevel { get; set; }

    const int MAX_REG = 16;


    RegistersData element = new RegistersData();


    protected override void OnParametersSet()
    {
        if (RegisterFile != null)
        {
            element.SetParams(RegisterFile, RegisterLevel);
            base.OnParametersSet();
        }
    }



    private void Reset()
    {
        element = new RegistersData();
        StateHasChanged();
    }

    /// <summary>
    /// Clear the "UI element showing the field has changed" (!)
    /// </summary>
    public void ResetUI()
    {
        element.ResetUI();
        StateHasChanged();
    }

    // Helper class
    public class RegistersData
    {
        private ushort _RegisterLevel;
        private RegisterFile? _RegisterFile;
        public Register[] R;

        public RegistersData()
        {
            R = new Register[MAX_REG];
            for (ushort i = 0; i < MAX_REG; i++)
            {
                R[i] = new Register(i, "R" + i.ToString());
                R[i].UpdateValue(0, false);

                R[i].OnReadRegister += ReadRegisterEventHandler;
                R[i].OnWriteRegister += WriteRegisterEventHandler;
            }
        }

        internal void SetParams(RegisterFile RegisterFile, ushort RegisterLevel)
        {
            _RegisterLevel = RegisterLevel;
            _RegisterFile = RegisterFile;

            for (ushort i = 0; i < MAX_REG; i++)
            {
                ushort val = RegisterFile.UIRead(_RegisterLevel, i);
                R[i].SetDescription(RegisterFile.UIReadDescription(_RegisterLevel, i));
                R[i].SetLabel(RegisterFile.UIReadLabel(_RegisterLevel, i));
                //R[i].UpdateValue(val,true);
            }
        }

        public void Dispose()
        {
            int max = 16;
            for (int i = 0; i < max; i++)
            {
                R[i].OnReadRegister -= ReadRegisterEventHandler;
                R[i].OnWriteRegister -= WriteRegisterEventHandler;
            }

            _RegisterFile = null;
        }

        public void ReadRegisterEventHandler(object? sender, UpdateRegisterEvent e)
        {
            if (_RegisterFile != null)
            {
                ushort val = _RegisterFile.UIRead(_RegisterLevel, e.Register);

                e.Value = val;
                e.handled = true;
            }
        }


        public void WriteRegisterEventHandler(object? sender, UpdateRegisterEvent e)
        {
            if (_RegisterFile != null)
            {

                _RegisterFile.UIWrite(_RegisterLevel, e.Register, (ushort)e.Value);
                e.handled = true;
            }

        }

        public void ResetUI()
        {
            int max = 16;
            for (int i = 0; i < max; i++)
            {
                R[i].ClearUpdated();
            }
        }

    }
}



