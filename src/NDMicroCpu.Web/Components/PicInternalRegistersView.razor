            <MudTextField ReadOnly="@element.R[11].ReadOnly" @bind-Value="@element.R[11].OctalValue" Label="@element.R[11].Label" Variant="Variant.Outlined" title="@element.R[11].Description" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="@element.R[11].adornment" />
            <MudTextField ReadOnly="@element.R[12].ReadOnly" @bind-Value="@element.R[12].OctalValue" Label="@element.R[12].Label" Variant="Variant.Outlined" title="@element.R[12].Description" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="@element.R[12].adornment" />
            <MudTextField ReadOnly="@element.R[13].ReadOnly" @bind-Value="@element.R[13].OctalValue" Label="@element.R[13].Label" Variant="Variant.Outlined" title="@element.R[13].Description" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="@element.R[13].adornment" />
            <MudTextField ReadOnly="@element.R[14].ReadOnly" @bind-Value="@element.R[14].OctalValue" Label="@element.R[14].Label" Variant="Variant.Outlined" title="@element.R[14].Description" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="@element.R[14].adornment" />
