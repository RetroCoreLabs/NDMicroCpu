<Project>
  <!-- Central package versions. Every PackageReference in the repo takes its version from here; no csproj carries a Version attribute. Latest stable on nuget.org as of 2026-10-18. -->
  <PropertyGroup>
    <!-- Needed so the two transitive pins below apply: central pinning ignores packages nothing references directly unless this is on. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Transitive pins. System.ServiceModel.Primitives and protobuf-net.Grpc pull
      System.Security.Cryptography.Pkcs and .Xml at 10.0.0, which carry published advisories
      (NU1902/NU1903 on every build). 10.0.13 is the patched release on the same line.
      Remove both once the packages that pull them ask for 10.0.13 or later themselves.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <!-- tests -->
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <!-- web emulator (Blazor WebAssembly) -->
    <PackageVersion Include="BlazorMonaco" Version="3.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <!-- gRPC debugger -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="protobuf-net" Version="3.4.30" />
    <PackageVersion Include="protobuf-net.BuildTools" Version="3.3.8" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageVersion Include="System.IO.Ports" Version="10.0.13" />
    <PackageVersion Include="System.ServiceModel.Primitives" Version="10.0.652802" />
  </ItemGroup>
</Project>
