<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Command-line tool: lowercase, short, what it does (NAMING.md). -->
    <AssemblyName>ndmicrodebug</AssemblyName>
    <RootNamespace>NDMicroCpu.Debugger</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="protobuf-net" />
    <PackageReference Include="protobuf-net.BuildTools" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="protobuf-net.Grpc" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NDMicroCpu.Core\NDMicroCpu.Core.csproj" />
    <ProjectReference Include="..\NDMicroCpu.Debugger.Contracts\NDMicroCpu.Debugger.Contracts.csproj" />
  </ItemGroup>

  <!--
    Test programs (BPUN images) shipped next to the exe, the same way NDMicroCpu.Core ships its
    MicroCode\*.CODE images. Sourced from the Machine project so the repository holds ONE copy.
  -->
  <ItemGroup>
    <None Include="..\NDMicroCpu.Machine\BPUN\*.BPUN" Link="BPUN\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
