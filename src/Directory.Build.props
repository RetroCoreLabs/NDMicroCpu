<Project>
  <!-- Repo-wide build settings (NDMicroCpu). See NAMING.md "App repos" in the RetroCoreLabs workspace. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Run the .editorconfig code-style rules (file header IDE0073, using order) as part of the build, so a wrong header fails the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- NuGet audit findings stay warnings, not errors: a new advisory on a transitive package must not break every build the same morning. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Ronny Hansen</Authors>
    <Company>RetroCoreLabs</Company>
    <Copyright>Copyright (c) 1985-$([System.DateTime]::Now.Year) Ronny Hansen</Copyright>
    <PackageProjectUrl>https://github.com/RetroCoreLabs/NDMicroCpu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RetroCoreLabs/NDMicroCpu</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Application and library code ships its XML documentation: with TreatWarningsAsErrors on, a public member without a comment (CS1591) fails the build. Test projects are exempt. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
</Project>
